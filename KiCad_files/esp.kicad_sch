	)
	(text "GNSS moduulin M20048-1 footprinttiä ei löydy peruskirjastosta, en tiiä oisko jossain saatavilla\nSama homma IMUn kanssa (BNO055)\nSama hakkurin kanssa (MP2235SGJ-Z)\n\n\nTässä symbolit. Footprintit pitää tehdä vielä"
		(exclude_from_sim no)
		(at 146.05 43.688 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "87d8a6cf-b1fd-4727-90eb-53b543200311")
	)
	(text "SBU pins are \"sideband\" pins\nwhich are not used for USB 2.0.\nLeave floating"
		(exclude_from_sim no)
		(at 66.548 249.936 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8b1f6e45-921a-4336-8938-059c13a5bc93")
	)
	(text "Decoupling capacitors. \n1u for low-frequency stuff\nand 10n for high frequency\nspikes. Keep near chip"
		(exclude_from_sim no)
