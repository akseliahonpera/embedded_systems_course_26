			)
		)
		(uuid "3c48d5e2-eea4-4406-9e95-455dc4849249")
	)
	(text "UART interface. Cross-connect with MCU:\nRX -> TX, TX -> RX\nSelect baud rate with pins E2 & E3 \nOR via software"
