	(text "Hardware reset pin.\nIf not used, the hardware reset should be left floating, \nas it is pulled up by an internal 75 k resistor"
		(exclude_from_sim no)
		(at 42.926 101.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "90f74d90-4a24-460d-a641-c4e7f310fa62")
	)
	(text "Baud select. NC = not connected, PD = pull down\nBAUD RATE		E2		E3\n  9600			NC		NC\n 115200			NC		PD\n  4800			PD		NC\n  38400			PD		PD"
		(exclude_from_sim no)
		(at 42.418 143.002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bfb086fe-6947-41e8-b66a-26041c042baa")
	)
	(text "TODO: Tuning inductor and resistor are TBD\nNeed to research how to determine their values.\nThese vals are from the reference schematic\n\nRecommended package was"
		(exclude_from_sim no)
		(at 134.366 61.214 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c61cb7cd-345d-46f6-899c-4a8e2a8e6af2")
	)
	(text "FIX signal indicates whether the module has a fix on the position.\nIn other words, if it has locked onto enough satellites that it\ncan determine the position. Can't tell by the datasheet what it\noutputs. Probably just 0 or 1"
		(exclude_from_sim no)
		(at 250.698 135.636 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6089292-569f-4469-b3ad-e763f0f3d575")
	)
	(text "Pulse per second output, which provides a synchronized\noutput which is synchronized to GNSS time.\nPulse width is 100 ms. Enable with command PMTK255 \n\nLeave floating if not needed"
		(exclude_from_sim no)
		(at 42.672 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e57e087b-3dc8-4c3b-bc12-d26b741c9f17")
	)
	(text "Hardware controlled standby. Enable standby \nby sending a low state to this pin.\nTo wake up, send high state to this pin.\nIf not used, leave floating!"
		(exclude_from_sim no)
		(at 242.57 85.344 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee815f78-8c99-4933-8534-d388044109fd")
	)
