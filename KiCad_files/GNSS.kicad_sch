	(text "Backup voltage. Need a 3 volt battery to enable\nquick startup and satellite acquisition by the GPS\n\nTODO: Do other devices require this as well?\n"
		(exclude_from_sim no)
		(at 92.71 190.754 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2b1e2879-0f2e-426d-ada8-f888b8560599")
	)
	(text "Could probably use this to determine whether to\ninclude the GPS data into the sensor fusion\nif(FIX) do readgps()"
		(exclude_from_sim no)
		(at 248.92 145.034 0)
